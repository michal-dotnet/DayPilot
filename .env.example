# העתיקו לקובץ .env ומלאו את הערכים. הקובץ .env לא נכנס ל-git.

# OpenAI
OPENAI_API_KEY=sk-...
MODEL_NAME=gpt-6-luna

# LangSmith (נדרש בשלב 4)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=daypilot

# אימות HTTPS מול מאגר התעודות של Windows (מומלץ להשאיר true)
USE_SYSTEM_CERTIFICATES=true

# שרת מקומי
API_HOST=127.0.0.1
API_PORT=8000
